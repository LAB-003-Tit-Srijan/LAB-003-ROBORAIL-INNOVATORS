rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User Profile Images
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Item Images
    match /items/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null; // Ideally check if user owns the item, but simple for now
    }
  }
}
